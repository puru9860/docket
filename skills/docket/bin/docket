#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Docket CLI launcher: run the CLI package beside `bin/` from cached bytecode.

Python compiles a script it runs directly from source on every call, and the CLI is
large, so its code lives in the `docket_cli` package and this launcher imports it
instead. Each module's bytecode is checked against its source's hash, so an edit can
never run stale code, and it is kept under `PYTHONPYCACHEPREFIX` when set, otherwise
under the user's cache directory, never beside the package: a checkout docket
measures gains no `__pycache__`.
"""

import importlib.util
import os
import py_compile
import sys
from pathlib import Path

PACKAGE = Path(__file__).resolve().parent.parent / "docket_cli"


def hash_checked(pyc: str) -> bool:
    """Whether a bytecode file is current-version and validated against its source."""
    try:
        with open(pyc, "rb") as fh:
            head = fh.read(8)
    except OSError:
        return False
    return head[:4] == importlib.util.MAGIC_NUMBER and int.from_bytes(head[4:], "little") == 0b11


if sys.pycache_prefix is None:
    cache = os.environ.get("XDG_CACHE_HOME", "")
    if not os.path.isabs(cache):
        cache = os.path.join(os.path.expanduser("~"), ".cache")
    sys.pycache_prefix = os.path.join(cache, "docket", "pycache")
for source in sorted(PACKAGE.glob("*.py")):
    pyc = importlib.util.cache_from_source(str(source))
    if not sys.dont_write_bytecode and not hash_checked(pyc):
        try:
            py_compile.compile(str(source), cfile=pyc, doraise=True,
                               invalidation_mode=py_compile.PycInvalidationMode.CHECKED_HASH)
        except (OSError, py_compile.PyCompileError):
            pass  # The import below compiles in memory and reports any syntax error.
spec = importlib.util.spec_from_file_location("docket_cli", PACKAGE / "__init__.py",
                                              submodule_search_locations=[str(PACKAGE)])
assert spec is not None and spec.loader is not None
module = importlib.util.module_from_spec(spec)
sys.modules["docket_cli"] = module
spec.loader.exec_module(module)
module.main()
